<%# Index des chapitres de l'accueil : sticky en desktop (lg+), masqué en dessous. État actif posé par chapters.js %>
<aside class="hidden lg:block">
  <nav class="sticky top-24" aria-label="Chapitres">
    <ol class="space-y-1">
      <% chapters.forEach(function (c) { %>
        <li>
          <a class="chapter-index__link" href="#<%= c.id %>" data-chapter-link="<%= c.id %>">
            <span class="font-mono text-accenth/80"><%= c.num %></span>
            <span><%= c.label %></span>
          </a>
        </li>
      <% }); %>
    </ol>
  </nav>
</aside>
