<%#
  Chapitre 01 : infrastructure en direct.
  La liste est la version accessible : seule visible sans JS et en mobile, masquée visuellement
  (mais lue par les lecteurs d'écran) quand infra-iso.js a construit la scène 3D décorative.
%>
<%
  const services = infraServices || [];
  const upCount = services.filter((s) => s.up).length;
  const latScale = (ms) => ms == null ? 0 : Math.max(0.06, Math.min(ms / 200, 1));
%>
<div class="infra" data-infra data-name="<%= homelabName %>" data-initial="<%= JSON.stringify(services) %>">

  <div class="infra-scene card" data-infra-scene aria-hidden="true"></div>

  <p class="mt-4 text-xs text-muted" data-infra-summary>
    <% if (services.length) { %>
      <%= upCount %> service<%= upCount > 1 ? 's' : '' %> sur <%= services.length %> en ligne
    <% } else { %>
      Données de la status page indisponibles pour le moment.
    <% } %>
  </p>

  <ul class="infra-list mt-4 grid gap-2 sm:grid-cols-2" data-infra-list>
    <% services.forEach(function (s) { %>
      <li class="infra-item card flex items-center gap-3 px-5 py-4" data-up="<%= s.up %>">
        <span class="infra-dot" aria-hidden="true"></span>
        <span class="min-w-0 flex-1">
          <span class="block truncate text-sm font-medium text-strong"><%= s.name %></span>
          <span class="block truncate text-xs text-muted"><%= s.group %> · <%= s.up ? 'en ligne' : 'hors ligne' %></span>
        </span>
        <span class="flex w-20 flex-none flex-col items-end gap-1.5">
          <span class="font-mono text-xs tabular-nums text-body"><%= s.latency != null ? s.latency + ' ms' : 'n.d.' %></span>
          <span class="infra-bar" aria-hidden="true"><span class="infra-bar__fill" style="--lat: <%= latScale(s.latency) %>"></span></span>
        </span>
      </li>
    <% }); %>
  </ul>

</div>
