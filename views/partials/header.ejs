<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title || 'Olivier D.' %></title>

  <meta name="description" content="<%= description || 'Olivier DUTOIT - Étudiant en BTS SIO SISR, passionné d\'infrastructure IT.' %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= url || 'https://www.olivier-dutoit.fr' %>">
  <meta property="og:title" content="<%= title || 'Olivier D.' %>">
  <meta property="og:description" content="<%= description || 'Étudiant en BTS SIO SISR, passionné d\'infrastructure IT.' %>">
  <meta property="og:image" content="<%= ogImage || 'https://www.olivier-dutoit.fr/og-image.png' %>">

  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <% (locals.preloadImages || []).forEach(function (img) { %>
  <link rel="preload" as="image" href="<%= img.href %>" media="<%= img.media %>" fetchpriority="high">
  <% }); %>
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/effects.js" defer></script>
</head>
<body class="min-h-screen bg-bg font-sans text-[15px] leading-relaxed text-body antialiased">

  <nav class="sticky top-0 z-50 border-b border-line bg-bg/60 backdrop-blur-2xl backdrop-saturate-150">
    <div class="mx-auto flex h-11 max-w-content items-center gap-6 px-6">
      <a href="/" class="flex-none text-[13px] font-semibold tracking-tight text-strong">Olivier D.</a>
      <%# Index des chapitres de l'accueil : chapitre actif posé par chapters.js (aria-current) %>
      <ol class="nav-chapters ml-auto flex min-w-0 items-center gap-5 overflow-x-auto" data-nav-chapters aria-label="Chapitres">
        <% (locals.navChapters || []).forEach(function (c) { %>
          <li class="flex-none">
            <a href="/#<%= c.id %>" class="nav-link flex items-baseline gap-1.5 text-xs font-normal transition-colors" data-chapter-link="<%= c.id %>">
              <span class="font-mono text-[10px] text-accenth"><%= c.num %></span><%= c.label %>
            </a>
          </li>
        <% }); %>
      </ol>
    </div>
  </nav>

  <main>
