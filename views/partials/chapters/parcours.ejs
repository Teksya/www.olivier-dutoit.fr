<!-- MODAL VÉRIFICATION DIPLÔME -->
<div id="diploma-modal" hidden>
  <div class="absolute inset-0 bg-black/60 backdrop-blur-md" data-diploma-close></div>
  <div class="relative z-10 w-full max-w-md card p-8 text-center sm:p-10" role="dialog" aria-modal="true" aria-labelledby="dv-title">
    <button type="button" class="dv-close absolute right-5 top-5 flex h-8 w-8 items-center justify-center rounded-full text-muted transition-colors hover:bg-surface2 hover:text-strong" data-diploma-close aria-label="Fermer">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <h2 id="dv-title" class="text-2xl font-semibold tracking-tight text-strong">Bac Pro CIEL</h2>
    <p class="mt-1.5 text-sm text-muted">Authenticité vérifiable &middot; 2026</p>
    <div class="mt-8 inline-flex rounded-3xl bg-white p-5 shadow-xl shadow-black/30">
      <img class="block h-auto w-72 max-w-full" src="/diploma-ciel-qr.svg" width="288" height="288" decoding="async" alt="QR code de vérification d'authenticité du diplôme Bac Pro CIEL">
    </div>
    <p class="mx-auto mt-8 max-w-xs text-sm leading-relaxed text-muted">
      Scannez ce code avec l'application <span class="font-medium text-body">Cyclades Vérif</span> pour vérifier l'authenticité du diplôme.
    </p>
