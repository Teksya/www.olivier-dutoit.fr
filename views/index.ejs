<%- include('partials/header') %>

<%
  // Chapitres définis dans server.js (getHomeChapters), partagés avec le header.
  // Scripts lourds chargés à l'approche du chapitre (chapters.js, data-lazy-script).
  const lazyScripts = {
    'en-direct': '/js/about.js',
    'contact': 'https://challenges.cloudflare.com/turnstile/v0/api.js'
  };
%>

<%- include('partials/hero-homelab') %>

<div class="mx-auto max-w-content px-6 pb-16 sm:pb-20">

  <% navChapters.forEach(function (c) { %>
    <section class="chapter" id="<%= c.id %>" aria-labelledby="<%= c.id %>-titre"<% if (lazyScripts[c.id]) { %> data-lazy-script="<%= lazyScripts[c.id] %>"<% } %>>
      <div class="reveal">
        <p class="chapter-num"><%= c.num %></p>
        <h2 class="chapter-title" id="<%= c.id %>-titre"><%= c.title %></h2>
        <p class="chapter-text"><%= c.text %></p>
      </div>
      <div class="chapter-visual">
        <%- include('partials/chapters/' + c.id) %>
      </div>
    </section>
  <% }); %>

</div>

<script src="/js/hero-homelab.js" defer></script>
<script src="/js/diploma-verify.js" defer></script>
<script src="/js/chapters.js" defer></script>

<%- include('partials/footer') %>
