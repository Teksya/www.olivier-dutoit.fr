<%- include('partials/header') %>

<%
  const chapters = [
    { num: '01', id: 'chapitre-infrastructure', label: 'Infrastructure', title: 'Infrastructure',
      text: 'Les services de mon homelab, relevés en direct sur ma status page. Chaque bloc est un service : vert s\'il répond, avec sa latence.' },
    { num: '02', id: 'chapitre-ce-site', label: 'Ce site', title: 'Comment ce site est servi',
      text: 'Le chemin d\'une requête, de votre navigateur jusqu\'au container qui répond. À chaque étape, les contrôles qui la protègent.' },
    { num: '03', id: 'chapitre-projets', label: 'Projets', title: 'Projets mis en avant',
      text: 'Une sélection de réalisations, entre infrastructure et développement. Le reste est sur la page Travaux.' },
    { num: '04', id: 'chapitre-competences', label: 'Compétences', title: 'Compétences',
      text: 'Ce que j\'utilise en cours comme en alternance, rangé par domaine.' }
  ];

  const skills = [
    { domain: 'Réseaux et systèmes', items: ['Windows Server', 'Linux', 'Cisco', 'Mikrotik', 'Proxmox'] },
    { domain: 'Langages', items: ['JavaScript', 'Node.js', 'PHP', 'Python', 'C#'] },
    { domain: 'Front-end', items: ['HTML/CSS', 'Tailwind CSS', 'Figma', 'Canva'] },
    { domain: 'Outils', items: ['Docker', 'Git', 'MySQL', 'Wireshark'] }
  ];

  function chapterHead(c) { %>
    <p class="chapter-num"><%= c.num %></p>
    <h2 class="chapter-title" id="<%= c.id %>-titre"><%= c.title %></h2>
    <p class="chapter-text"><%= c.text %></p>
<% } %>

<div class="mx-auto max-w-wide px-6 py-16 sm:py-20">
  <div class="lg:grid lg:grid-cols-[9rem_minmax(0,1fr)] lg:gap-12">

    <%- include('partials/chapter-index', { chapters }) %>

    <div class="min-w-0">

      <!-- HERO -->
      <section class="reveal" aria-labelledby="hero-titre">
        <p class="eyebrow">Étudiant en informatique</p>
        <h1 id="hero-titre" class="mt-5 text-4xl font-semibold leading-[1.05] tracking-tight text-strong sm:text-6xl sm:leading-none">Olivier Dutoit</h1>
        <p class="mt-6 max-w-xl text-[15px] leading-relaxed text-body">
          Actuellement en <strong class="font-medium text-strong">1<sup>re</sup> année de BTS SIO SISR</strong> en alternance,
          après un <strong class="font-medium text-strong">Bac Pro CIEL</strong> mention Très Bien. Passionné par l'infrastructure IT.
        </p>
        <p class="mt-6">
          <span class="inline-flex items-center gap-2 rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accenth">
            <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>BTS SIO SISR en alternance · Saint-Étienne
          </span>
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/work" class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accenth">Voir mes projets</a>
          <a href="/contact" class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-medium text-body transition-colors hover:border-line2 hover:text-strong">Me contacter</a>
        </div>
      </section>

      <!-- 01 INFRASTRUCTURE (scène iso : phase 3) -->
      <section class="chapter" id="<%= chapters[0].id %>" aria-labelledby="<%= chapters[0].id %>-titre">
        <div class="reveal"><% chapterHead(chapters[0]); %></div>
        <div class="chapter-visual reveal">
          <div class="flex min-h-64 items-center justify-center rounded-3xl border border-dashed border-line2 text-sm text-muted">Scène en préparation</div>
        </div>
      </section>

      <!-- 02 COMMENT CE SITE EST SERVI (flux : phase 4) -->
      <section class="chapter" id="<%= chapters[1].id %>" aria-labelledby="<%= chapters[1].id %>-titre">
        <div class="reveal"><% chapterHead(chapters[1]); %></div>
        <div class="chapter-visual reveal">
          <div class="flex min-h-64 items-center justify-center rounded-3xl border border-dashed border-line2 text-sm text-muted">Schéma en préparation</div>
        </div>
      </section>

      <!-- 03 PROJETS MIS EN AVANT -->
      <section class="chapter" id="<%= chapters[2].id %>" aria-labelledby="<%= chapters[2].id %>-titre">
        <div class="reveal"><% chapterHead(chapters[2]); %></div>
        <div class="chapter-visual">
          <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <% homeProjects.forEach(function (project, i) { %>
              <li class="reveal" style="transition-delay:<%= i * 0.05 %>s">
                <a href="/work" class="card card-hover group flex h-full flex-col overflow-hidden">
                  <span class="block aspect-video overflow-hidden">
                    <img loading="lazy" src="<%= project.image %>" alt="" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105">
                  </span>
                  <span class="flex flex-1 flex-col p-6">
                    <span class="font-semibold text-strong"><%= project.title %></span>
                    <span class="mt-1.5 text-sm leading-relaxed text-body"><%= project.description %></span>
                  </span>
                </a>
              </li>
            <% }); %>
          </ul>
          <a href="/work" class="reveal mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-accenth transition-colors hover:text-strong">
            Tous les projets <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </section>

      <!-- 04 COMPÉTENCES -->
      <section class="chapter" id="<%= chapters[3].id %>" aria-labelledby="<%= chapters[3].id %>-titre">
        <div class="reveal"><% chapterHead(chapters[3]); %></div>
        <div class="chapter-visual reveal">
          <div class="card grid gap-px overflow-hidden bg-line sm:grid-cols-2 lg:grid-cols-4">
            <% skills.forEach(function (group) { %>
              <div class="bg-surface p-6">
                <h3 class="text-sm font-semibold text-strong"><%= group.domain %></h3>
                <ul class="mt-4 space-y-2 text-sm text-body">
                  <% group.items.forEach(function (item) { %>
                    <li><%= item %></li>
                  <% }); %>
                </ul>
              </div>
            <% }); %>
          </div>
        </div>
      </section>

    </div>
  </div>
</div>

<script src="/js/chapters.js" defer></script>

<%- include('partials/footer') %>
